{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "mp-practice-adf"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ttchcemr.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().db_name}"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mpmukundh"
		},
		"audit_logs_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ttchcemr.database.windows.net"
		},
		"audit_logs_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "audit-logs"
		},
		"audit_logs_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mpmukundh"
		},
		"from_files_to_database_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mpmypracticesadev.dfs.core.windows.net/"
		},
		"mp_practice_hc_kv_ls_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://mp-practice-hc-kv.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "mp-practice-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"mp_practice_hc_kv_ls_properties_typeProperties_baseUrl": {
						"value": "[parameters('mp_practice_hc_kv_ls_properties_typeProperties_baseUrl')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"audit_logs_ls_properties_typeProperties_server": {
						"value": "[parameters('audit_logs_ls_properties_typeProperties_server')]"
					},
					"audit_logs_ls_properties_typeProperties_database": {
						"value": "[parameters('audit_logs_ls_properties_typeProperties_database')]"
					},
					"audit_logs_ls_properties_typeProperties_userName": {
						"value": "[parameters('audit_logs_ls_properties_typeProperties_userName')]"
					},
					"from_files_to_database_properties_typeProperties_url": {
						"value": "[parameters('from_files_to_database_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}